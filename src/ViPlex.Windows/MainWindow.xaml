<Window x:Class="ViPlex.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViPlex USB Editor" Width="1320" Height="860" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ImageResizeHandle" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="-6" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WindowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBackgroundBrush}" Width="38" Height="38" CornerRadius="9" Margin="0,0,12,0">
                        <Grid Width="20" Height="14">
                            <Rectangle Fill="{StaticResource AccentBrush}" Width="4" Height="11" RadiusX="1" RadiusY="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <Rectangle Fill="{StaticResource AccentBrush}" Width="4" Height="14" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            <Rectangle Fill="{StaticResource AccentBrush}" Width="4" Height="8" RadiusX="1" RadiusY="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ViPlex USB Editor" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="NovaStar T10  ·  256 × 768" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RestoreButton" Click="Restore_Click" Content="Restore USB backup" Margin="0,0,8,0" />
                    <Button x:Name="OpenButton" Click="Open_Click" Margin="0,0,8,0" AutomationProperties.Name="Open USB or folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                            <AccessText Text="_Open USB or folder" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PrepareButton" Style="{StaticResource PrimaryButton}" Click="Prepare_Click"
                            IsEnabled="False" AutomationProperties.Name="Prepare set">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" Margin="0,0,8,0" />
                            <AccessText Text="_Prepare set" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="Editor" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="292" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18,21,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Preset sets" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button x:Name="RenameSetButton" Content="Rename…" Click="RenameSet_Click" HorizontalAlignment="Right"
                                MinHeight="30" Padding="8,4" IsEnabled="False" AutomationProperties.Name="Rename set" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SetSelector" MinHeight="34" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                  SelectionChanged="SetSelection_Changed" AutomationProperties.Name="Preset set" IsEnabled="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="NewSetButton" Grid.Column="1" Content="New set…" Click="NewSet_Click" IsEnabled="False" />
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,15,0,12">
                        <TextBlock x:Name="ProgramName" Text="No program loaded" FontWeight="SemiBold" FontSize="20" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProgramSummary" Text="Open a folder to load or create a program." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <ListBox x:Name="PageList" Grid.Row="3" BorderThickness="0" Padding="2,3,2,2"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                             SelectionChanged="PageSelection_Changed" AutomationProperties.Name="Ordered playlist pages">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource WindowBrush}" CornerRadius="3" Height="54" Width="24" HorizontalAlignment="Left" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Pending" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,4,0,0"
                                                   Visibility="{Binding Pending, Converter={StaticResource ShowWhenTrue}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="PageActions" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button Content="Add pages…" Click="AddPages_Click" Margin="0,0,3,0" Padding="5,5" MinHeight="34" />
                            <Button x:Name="DuplicatePageButton" Content="Duplicate" Click="DuplicatePage_Click"
                                    Margin="3,0,0,0" Padding="5,5" MinHeight="34" />
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <Button x:Name="MovePageUpButton" Content="Move up" Click="MovePageUp_Click" Margin="0,0,3,0" Padding="5,5" MinHeight="34" />
                            <Button x:Name="MovePageDownButton" Content="Move down" Click="MovePageDown_Click" Margin="3,0" Padding="4,5" MinHeight="34" />
                            <Button x:Name="RemovePageButton" Content="Remove" Click="RemovePage_Click" Margin="3,0,0,0" Padding="5,5" MinHeight="34" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="20,20,20,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,13">
                    <TextBlock Text="Preview" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ResetImageButton" Content="Reset image" Click="ResetImage_Click" Visibility="Collapsed"
                                ToolTip="Fit and center the image" MinHeight="32" Margin="0,0,8,0" Padding="10,5" />
                        <Button x:Name="EditImageButton" Content="Edit image" Click="ToggleImageEditing_Click" Visibility="Collapsed"
                                ToolTip="Drag the image to move it. Drag a corner to resize it." MinHeight="32" Margin="0,0,8,0" Padding="10,5" />
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                            <TextBlock Text="256 × 768" Style="{StaticResource MutedText}" FontSize="12" />
                        </Border>
                        <Button x:Name="PlayButton" Click="Play_Click" MinWidth="92" MinHeight="32" Margin="8,0,0,0" Padding="10,5"
                                Content="Play video" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" CornerRadius="11" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#101619">
                    <Grid ClipToBounds="True">
                        <Grid.Background>
                            <DrawingBrush Viewport="0,0,18,18" ViewportUnits="Absolute" TileMode="Tile">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#101619" Geometry="M 0,0 H 18 V 18 H 0 Z" />
                                        <GeometryDrawing Brush="#2D393D" Geometry="M 0,0 H 1 V 1 H 0 Z" />
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>
                        <Viewbox x:Name="ScreenView" Margin="18" MaxWidth="205" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Border Padding="5" Background="#090C0E" BorderThickness="2" BorderBrush="#52636A" CornerRadius="10">
                                <Grid x:Name="Stage" Width="256" Height="768" Background="Black" ClipToBounds="True"
                                      LayoutUpdated="Stage_LayoutUpdated">
                                    <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                                  MediaOpened="PreviewMedia_Opened" MediaEnded="PreviewMedia_Ended" MediaFailed="PreviewMedia_Failed" />
                                    <Image x:Name="Poster" Stretch="Uniform" />
                                    <Canvas x:Name="PhotoLayer" IsHitTestVisible="False" UseLayoutRounding="False">
                                        <Image x:Name="Photo" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Viewbox>
                        <Canvas x:Name="ImageOverlay">
                            <Grid x:Name="ImageSelection" Background="Transparent" Cursor="SizeAll" Visibility="Collapsed"
                                  MouseLeftButtonDown="ImageSelection_MouseDown" MouseMove="ImageSelection_MouseMove"
                                  MouseLeftButtonUp="ImageSelection_MouseUp" LostMouseCapture="ImageSelection_LostMouseCapture">
                                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" IsHitTestVisible="False" />
                                <Border Style="{StaticResource ImageResizeHandle}" Tag="TopLeft" Cursor="SizeNWSE"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Border Style="{StaticResource ImageResizeHandle}" Tag="TopRight" Cursor="SizeNESW"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" />
                                <Border Style="{StaticResource ImageResizeHandle}" Tag="BottomLeft" Cursor="SizeNESW"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <Border Style="{StaticResource ImageResizeHandle}" Tag="BottomRight" Cursor="SizeNWSE"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                        </Canvas>
                        <Border x:Name="EmptyPreview" CornerRadius="11" Background="#D4141B1E" Padding="22" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                            <StackPanel>
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="27" HorizontalAlignment="Center" />
                                <TextBlock Text="Open a USB drive or folder" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,6" />
                                <TextBlock Text="Edit an existing ViPlex export or create a program for a blank drive."
                                           Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" />
                                <Button Click="Open_Click" Content="Open folder" HorizontalAlignment="Center" Margin="0,15,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,13,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="74" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Media strip" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <Button x:Name="ImportButton" Click="Import_Click" IsEnabled="False" HorizontalAlignment="Right" MinHeight="32" Padding="10,5" Content="＋ Import media" />
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,7,0,0">
                        <Grid>
                            <TextBlock x:Name="EmptyStrip" Style="{StaticResource MutedText}" Text="Imported media will appear here for reuse across pages." TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" />
                            <ScrollViewer x:Name="MediaScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="5" Visibility="Collapsed">
                                <ItemsControl x:Name="MediaStrip" AutomationProperties.Name="Imported media">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="ApplyMedia_Click" Margin="0,0,5,0" Width="164" MinHeight="38" Padding="6,3"
                                                    HorizontalContentAlignment="Stretch" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding ApplyLabel}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="32" Background="{StaticResource WindowBrush}" HorizontalAlignment="Left" CornerRadius="3" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details.Kind}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="17,21,17,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Page properties" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="EmptyProperties" Grid.Row="1" Text="Select a page to view its media and playback duration."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,20,0,0" />
                    <ScrollViewer x:Name="PropertyScroll" Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="SelectedName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedPosition" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,15" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Media file" Style="{StaticResource PropertyLabel}" />
                                    <TextBlock x:Name="SelectedFile" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Grid Margin="0,17,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Type" Style="{StaticResource PropertyLabel}" />
                                            <TextBlock x:Name="SelectedKind" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Duration" Style="{StaticResource PropertyLabel}" />
                                            <TextBlock x:Name="SelectedDuration" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="SelectedPlayback" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="Edit page…" Click="EditPage_Click" Style="{StaticResource PrimaryButton}" Margin="0,15,0,0" />
                            <Button x:Name="ReplaceButton" Click="Replace_Click" Margin="0,15,0,0"
                                    AutomationProperties.Name="Replace media">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Margin="0,0,8,0" />
                                    <TextBlock Text="Replace media" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ReplaceFeedback" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="Activity" Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="20,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ActivityTitle" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ActivityDetail" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,12,0" />
                    <ProgressBar x:Name="ActivityProgress" IsIndeterminate="True" Margin="0,9,0,0" />
                </StackPanel>
                <Button x:Name="DismissActivityButton" Grid.Column="1" Click="DismissActivity_Click" Content="Dismiss" MinHeight="34" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SourceStatus" Text="No export open" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="EditStatus" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Grid.Column="2" Text="© Josh Andrew Esmade" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
