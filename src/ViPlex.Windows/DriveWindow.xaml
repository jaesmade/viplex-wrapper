<Window x:Class="ViPlex.Windows.DriveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose USB drive" Width="450" Height="340" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="21,17">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,11">
            <TextBlock Text="Choose USB drive" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Removable drives detected by Windows" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7">
            <Grid>
                <ListBox x:Name="Drives" Background="Transparent" BorderThickness="0" Padding="8" DisplayMemberPath="Label"
                         AutomationProperties.Name="Removable drives" SelectionChanged="Drive_Changed" />
                <TextBlock x:Name="DriveStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="13" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,11,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="UseButton" Content="Use this drive" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        IsEnabled="False" Click="Use_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
