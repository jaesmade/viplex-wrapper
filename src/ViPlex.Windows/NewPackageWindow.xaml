<Window x:Class="ViPlex.Windows.NewPackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="Create USB program" Width="550" Height="620" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </Window.Resources>
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="Inputs">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="DialogHeading" Text="Create USB program" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="NovaStar T10  ·  256 × 768" Style="{StaticResource MutedText}" Margin="0,5,0,14" />
                <TextBlock Text="Program name" Style="{StaticResource PropertyLabel}" />
                <TextBox x:Name="ProgramInput" AutomationProperties.Name="Program name" MaxLength="120" />
                <Grid x:Name="CredentialsInputs" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Player username" Style="{StaticResource PropertyLabel}" />
                        <TextBox x:Name="UserInput" Text="admin" AutomationProperties.Name="Player username" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Player password" Style="{StaticResource PropertyLabel}" />
                        <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Player password" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,15,0,8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PlaylistHeading" Text="Playlist media" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Pages play in the order below." Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="AddPagesButton" Content="Add media…" Click="Add_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <ListBox x:Name="Playlist" Background="Transparent" BorderThickness="0" Padding="7" DisplayMemberPath="Name"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Playlist_Changed" AutomationProperties.Name="Playlist in playback order" />
                        <TextBlock x:Name="EmptyPlaylist" Text="Add JPEG, PNG, or H.264 MP4 media." Style="{StaticResource MutedText}" Margin="12"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button x:Name="MoveUpButton" Content="Move up" Click="MoveUp_Click" IsEnabled="False" Margin="0,0,0,6" />
                    <Button x:Name="MoveDownButton" Content="Move down" Click="MoveDown_Click" IsEnabled="False" Margin="0,0,0,6" />
                    <Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="Feedback" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="WorkingProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="CreateButton" Content="Create program" Style="{StaticResource PrimaryButton}" Click="Create_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
